# Copy to `.env.local` and fill in from your Supabase project
# (Project Settings → API). Never commit `.env.local`.

# Public — safe in the browser, protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by `npm run seed` to bypass RLS. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# The one email allowed into /admin. Must match `app_settings.admin_email`
# (the seed writes it) so the database RLS check agrees with the app.
ADMIN_EMAIL=you@example.com

# Optional
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Absolute URL for the PageHero artwork; falls back to /images/hero.jpg.
NEXT_PUBLIC_HERO_IMAGE_URL=
